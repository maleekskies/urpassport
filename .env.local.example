# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never exposed to the client. Required for
# the expiry-reminder cron route (writes notification_log, bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Trip Planner (Anthropic) ────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Max itineraries a single user can generate per rolling 24h window.
AI_PLANNER_DAILY_LIMIT=5

# ── Live Visa Requirements (Travel Buddy, via RapidAPI) ────
# Sign up at rapidapi.com, subscribe to the "Travel Buddy - Visa Requirements
# API" (free tier available), and copy your RapidAPI key below.
RAPIDAPI_KEY=
RAPIDAPI_VISA_HOST=visa-requirement.p.rapidapi.com
# How long a cached country's result stays valid before refetching.
VISA_CACHE_TTL_HOURS=24

# ── Flights (Duffel) ─────────────────────────────────────────
# Free self-serve signup at duffel.com. Use a test-mode token
# (starts with duffel_test_) until you're ready for production bookings,
# which switch to a duffel_live_ token and Duffel's pay-per-order pricing.
DUFFEL_ACCESS_TOKEN=

# ── Billing (Paystack) ──────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Full URL Paystack redirects back to after checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend), expiry reminders ───────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=UrPassport NG <notifications@yourdomain.com>

# ── Cron protection ──────────────────────────────────────────
# Shared secret the scheduler (Vercel Cron / Supabase Cron / GitHub Actions)
# must send as `Authorization: Bearer <value>` to hit /api/cron/* routes.
CRON_SECRET=
